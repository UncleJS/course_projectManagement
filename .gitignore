# =============================================================================
# ENVIRONMENT & SECRETS
# =============================================================================

# Environment variable files — never commit real credentials
.env
.env.example
.env.local
.env.*.local
.env.development
.env.staging
.env.production

# =============================================================================
# CONFIGURATION FILES WITH CREDENTIALS / PASSWORDS
# =============================================================================

config.json
config.yaml
config.yml
config.toml
secrets.json
secrets.yaml
secrets.yml
secrets.toml
credentials.json
credentials.yaml
credentials.yml
credentials.toml
settings.json
settings.local.json

# Key / certificate files
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# =============================================================================
# OS GENERATED FILES
# =============================================================================

.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# =============================================================================
# EDITOR & IDE FILES
# =============================================================================

# VS Code — keep shared settings but exclude private/local overrides
.vscode/settings.json
.vscode/launch.json
.vscode/.ropeproject

# JetBrains IDEs
.idea/
*.iml
*.iws
*.ipr

# Vim / Emacs swap files
*.swp
*.swo
*~
\#*\#
.#*

# =============================================================================
# NODE.JS (if tooling is added)
# =============================================================================

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
.npm/

# =============================================================================
# PYTHON (if tooling is added)
# =============================================================================

__pycache__/
*.py[cod]
*.pyo
*.pyd
venv/
.venv/
env/
.eggs/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/

# =============================================================================
# LOGS & TEMPORARY FILES
# =============================================================================

*.log
logs/
*.tmp
*.temp
*.bak
*.orig
.cache/
